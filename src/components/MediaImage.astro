---
/**
 * 카드·상세 헤더 미디어의 이미지 한 장. kind에 따라 그대로 두거나 CSS 기기 목업에 넣는다.
 * - shot · device · plain: <Image> 하나(예전과 같음). 클래스는 `${baseClass} ${baseClass}--${kind}`.
 * - laptop · phone · tablet: 캡처를 CSS로 그린 기기 프레임에 넣는다(사용자 결정 2026-10-17: 첫 이미지를 모두 목업 느낌으로).
 *   바깥 span이 baseClass를 받으므로 hover 확대·이미지 실패 처리는 프레임째로 된다.
 *   프레임 크기는 미디어 프레임(container-type: size)의 cq 단위로 정해, 프레임 비율이 달라도 넘치지 않는다.
 */
import { Image } from 'astro:assets';
import type { ProjectImage } from '../data/projects';

interface Props {
  image: ProjectImage;
  baseClass: string;
  loading: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'auto';
  widths: number[];
  sizes: string;
}

const { image, baseClass, ...imageProps } = Astro.props;
const isMockup = image.kind === 'laptop' || image.kind === 'phone' || image.kind === 'tablet';

/**
 * 화면 안쪽 비율을 캡처 비율(r)에 맞춰 캡처가 잘리지 않게 한다. 베젤(padding %)은 목업 폭 W 기준이다.
 * laptop: 화면 폭 0.88W, 베젤 좌우 2.4%·위 2.4%·아래 3% → 안쪽 0.832W × 0.832W/r, 받침 0.036W
 * phone: 베젤 4% · tablet: 베젤 2.6%
 */
const r = image.src.width / image.src.height;
const mockupVars = (() => {
  if (image.kind === 'laptop') {
    const screenHeight = 0.832 / r + 0.054;
    return `--mockup-ratio: ${1 / (screenHeight + 0.036)}; --screen-ratio: ${0.88 / screenHeight}`;
  }
  const bezel = image.kind === 'phone' ? 0.04 : 0.026;
  const ratio = 1 / ((1 - 2 * bezel) / r + 2 * bezel);
  return `--mockup-ratio: ${ratio}; --screen-ratio: ${ratio}`;
})();
---

{
  isMockup ? (
    <span class:list={[baseClass, `${baseClass}--mockup`, 'mockup', `mockup--${image.kind}`]} style={mockupVars}>
      <span class="mockup-screen">
        <Image src={image.src} alt={image.alt} class="mockup-img" decoding="async" {...imageProps} />
      </span>
      {image.kind === 'laptop' && <span class="mockup-base" aria-hidden="true" />}
    </span>
  ) : (
    <Image src={image.src} alt={image.alt} class={`${baseClass} ${baseClass}--${image.kind}`} decoding="async" {...imageProps} />
  )
}

<style>
  .mockup {
    --mockup-bezel: #1d2028;
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: none;
    width: min(100cqw, 100cqh * var(--mockup-ratio));
    filter: drop-shadow(0 10px 18px rgb(28 35 51 / 0.14));
  }

  .mockup-screen {
    display: block;
    width: 100%;
    aspect-ratio: var(--screen-ratio);
    overflow: hidden;
    background: var(--mockup-bezel);
  }

  .mockup-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  /* 노트북: 화면(88% 폭) + 받침 */
  .mockup--laptop .mockup-screen {
    width: 88%;
    padding: 2.4% 2.4% 3%;
    border-radius: 3.2% 3.2% 0 0 / 5.2% 5.2% 0 0;
  }

  .mockup--laptop .mockup-img {
    border-radius: 1px;
  }

  .mockup-base {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 100 / 3.6;
    border-radius: 0 0 50% 50% / 0 0 100% 100%;
    background: linear-gradient(#e4e7ec, #b9bec7);
  }

  /* 받침 가운데 손가락 홈 */
  .mockup-base::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    width: 14%;
    height: 38%;
    border-radius: 0 0 6px 6px;
    background: #a9aeb8;
    translate: -50% 0;
  }

  /* 폰: 세로 화면을 둥근 베젤에 넣는다 */
  .mockup--phone .mockup-screen {
    padding: 4%;
    border-radius: 14% / 7%;
  }

  .mockup--phone .mockup-img {
    border-radius: 10% / 5%;
  }

  /* 태블릿·스탠바이미형 화면: 고른 베젤, 받침 없음 */
  .mockup--tablet .mockup-screen {
    padding: 2.6%;
    border-radius: 3.4% / 5.7%;
  }

  .mockup--tablet .mockup-img {
    border-radius: 1.4% / 2.4%;
  }
</style>
