---
/**
 * 상세 버튼: 프로젝트의 서비스 · GitHub · 프로토타입 등. 모두 새 탭으로 열고 ↗ 아이콘과 스크린리더용 "(새 창)"을 붙인다
 * (EXPERIENCE.md Component Patterns › Button). 링크가 없으면 렌더링하지 않는다(project-details.ts가 빌드에서 확인).
 * asset은 사이트에 함께 올린 파일이라 base 경로를 거친다.
 */
import type { DetailLink } from '../../data/project-details';
import { withBase } from '../../lib/paths';
import Icon from '../Icon.astro';

interface Props {
  link: DetailLink;
  variant: 'primary' | 'secondary';
}

const { link, variant } = Astro.props;
const href = link.kind === 'asset' ? withBase(link.href) : link.href;
---

{
  href && (
    <a
      class:list={['btn', variant === 'primary' ? 'btn-primary' : 'btn-secondary']}
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      data-detail-link={link.kind}
    >
      {link.label}
      <Icon name="external" />
      <span class="sr-only">(새 창)</span>
    </a>
  )
}
