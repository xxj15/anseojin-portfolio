---
/**
 * 상세 헤더 미디어(7컬럼): 16:10 surface-subtle 프레임에 스크린샷을 contain으로 넣는다(세로형 화면도 잘리지 않음).
 * 시각 규칙은 카드 미디어와 같다: shot = 작은 모서리 + 옅은 외곽선, device = 프레임 바탕과 곱하기, plain = 그대로,
 * laptop · phone · tablet = CSS 기기 목업(MediaImage).
 * 첫 화면 요소라 즉시 로드한다. 이미지 실패: 프레임을 유지하고 가운데에 프로젝트명(src/scripts/image-fallback.ts).
 */
import MediaImage from '../MediaImage.astro';
import type { ProjectImage, ProjectMedia } from '../../data/projects';

interface Props {
  media: ProjectMedia;
  name: string;
}

const { media, name } = Astro.props;

const sizing = (image: ProjectImage) =>
  image.src.height > image.src.width
    ? { widths: [240, 480, image.src.width].filter((w) => w <= image.src.width), sizes: '(min-width: 1024px) 220px, 34vw' }
    : {
        widths: [640, 1280, image.src.width].filter((w) => w <= image.src.width),
        sizes: '(min-width: 1280px) 626px, (min-width: 1024px) 52vw, calc(100vw - 104px)',
      };
---

<div class:list={['header-media', { 'header-media--inset-small': media.inset === 'small' }]} data-media-frame>
  {
    media.images.map((image, index) => (
      <MediaImage
        image={image}
        baseClass="header-image"
        loading="eager"
        fetchpriority={index === 0 ? 'high' : 'auto'}
        {...sizing(image)}
      />
    ))
  }
  <span class="media-fallback" aria-hidden="true">{name}</span>
</div>

<script>
  import '../../scripts/image-fallback';
</script>

<style>
  .header-media {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    aspect-ratio: 16 / 10;
    padding: var(--space-6);
    container-type: size;
    border-radius: var(--radius-lg);
    background: var(--surface-subtle);
    overflow: hidden;
  }

  .header-media--inset-small {
    padding: var(--space-4);
  }

  .header-media :global(.header-image:not(.header-image--mockup)) {
    min-width: 0;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
  }

  .header-media :global(.header-image--shot) {
    border-radius: var(--radius-sm);
    outline: 1px solid color-mix(in srgb, var(--ink-primary) 6%, transparent);
  }

  .header-media :global(.header-image--device) {
    mix-blend-mode: multiply;
  }

  .media-fallback {
    position: absolute;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    padding: var(--space-4);
    font-size: var(--caption-size);
    font-weight: var(--caption-weight);
    line-height: var(--caption-line);
    color: var(--ink-secondary);
    text-align: center;
  }

  .header-media:global(.is-media-failed) :global(.header-image) {
    opacity: 0;
  }

  .header-media:global(.is-media-failed) .media-fallback {
    display: flex;
  }

  @media (max-width: 767.98px) {
    .header-media {
      padding: var(--space-5);
    }

    .header-media--inset-small {
      padding: var(--space-3);
    }
  }
</style>
