---
/**
 * 모든 페이지 공용 레이아웃: skip link → header(nav) → main.
 * 페이지 끝의 contact-band는 없앴다(사용자 결정 2026-10-16). 연락처는 홈 About 섹션에만 있다.
 * 각 페이지는 마지막 내용 아래에 섹션 간격(160px · 모바일 96px)을 스스로 둔다.
 * html.js 클래스는 head의 인라인 스크립트가 붙인다. 리빌 등 "JS가 있을 때만" 규칙은 이 클래스에 기대며,
 * JS가 없으면 모든 콘텐츠가 기본으로 보인다.
 *
 * head에는 공유 미리보기(canonical · Open Graph · Twitter 카드)와 탭 아이콘도 둔다.
 * 절대 URL은 astro.config.mjs의 site + base로 만든다. 모든 페이지는 title·description만 넘기면 되고,
 * 상세 페이지처럼 미리보기 이미지나 형식을 바꿀 때만 ogImage·ogType을 넘긴다.
 */
import '../styles/tokens.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import { projects } from '../data/projects';
import { person } from '../data/site';
import { withBase } from '../lib/paths';

export interface OgImage {
  /** 사이트 경로(base 제외, 예: '/og/default.png') 또는 절대 URL */
  src: string;
  alt: string;
  width: number;
  height: number;
}

interface Props {
  title: string;
  description: string;
  /** 공유 미리보기 이미지. 기본은 사이트 공용 이미지(public/og/default.png). */
  ogImage?: OgImage;
  /** 기본 'website'. 상세 페이지는 'article'을 넘겨도 된다. */
  ogType?: 'website' | 'article';
  /** 검색 색인에서 뺀다(canonical·og:url도 생략). 404 페이지는 넘기지 않아도 자동으로 적용된다. */
  noindex?: boolean;
}

/** public/og/default.png(1200×630). 이미지는 정적 파일이라, 이미지를 다시 만들면 alt도 이미지 속 문구와 맞춘다. */
const DEFAULT_OG_IMAGE: OgImage = {
  src: '/og/default.png',
  alt: `${person.name} · ${person.role}. 기획과 UI/UX 디자인을 이해하고, 사용자 경험과 흐름을 설계하는 프론트엔드 개발자. 사용자 관점의 흐름 설계 · 기획부터 개발까지 직접 연결 · 아이디어를 실제 서비스로 완성`,
  width: 1200,
  height: 630,
};

const SITE_NAME = `${person.name} 포트폴리오`;
/** 브라우저 UI 색. 라이트 모드 전용이고 내비가 흰 바탕이므로 surface-base와 같다. */
const THEME_COLOR = '#ffffff';

const { title, description, ogImage = DEFAULT_OG_IMAGE, ogType = 'website' } = Astro.props;

const siteOrigin = Astro.site ?? Astro.url;
const absoluteUrl = (pathOrUrl: string) =>
  new URL(/^[a-z][a-z0-9+.-]*:/i.test(pathOrUrl) ? pathOrUrl : withBase(pathOrUrl), siteOrigin).href;

/** 404.html은 아무 주소에서나 보이므로 canonical을 두지 않는다. */
const isNotFound = /\/404(?:\.html)?\/?$/.test(Astro.url.pathname);
const noindex = Astro.props.noindex ?? isNotFound;
const canonicalUrl = noindex ? undefined : new URL(Astro.url.pathname, siteOrigin).href;
const ogImageUrl = absoluteUrl(ogImage.src);

/**
 * 레거시 해시 경로(EXPERIENCE.md State Patterns › 레거시 해시 경로). 이미 제출한 지원서 링크를 보호한다.
 * #/about → 홈 최상단, #/projects/<slug> → /projects/<slug>/, #/projects와 없는 slug → /#projects(예전 프로젝트 목록 탭),
 * #/tech → /#experience, #/activities → /#activities, 그 밖의 #/… → 홈 최상단.
 * '#/'로 시작하지 않는 해시(#projects 같은 일반 앵커)는 건드리지 않는다.
 */
const legacyRedirect = {
  legacyHome: withBase('/'),
  legacySlugs: projects.map((project) => project.slug),
};

/** Pretendard는 렌더링을 막지 않게 불러온다. CDN이 느리거나 막혀도 크기를 맞춘 폴백으로 텍스트가 바로 보인다. */
const PRETENDARD_CSS =
  'https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css';
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <script is:inline define:vars={legacyRedirect}>
      var redirectLegacyHash = function () {
        var hash = location.hash;
        if (hash.slice(0, 2) !== '#/') return;
        var route = hash.slice(2).split('?')[0].toLowerCase().split('/').filter(Boolean);
        var target = legacyHome;
        if (route[0] === 'projects') {
          // 끝 슬래시: 정적 호스팅(GitHub Pages)이 /projects/<slug> → /projects/<slug>/로 한 번 더 보내는 것을 줄인다
          target += legacySlugs.indexOf(route[1]) !== -1 ? 'projects/' + route[1] + '/' : '#projects';
        } else if (route[0] === 'tech') {
          target += '#experience';
        } else if (route[0] === 'activities') {
          target += '#activities';
        }
        var hashIndex = target.indexOf('#');
        var path = hashIndex === -1 ? target : target.slice(0, hashIndex);
        var next = path + location.search + (hashIndex === -1 ? '' : target.slice(hashIndex));
        if (next === location.pathname + location.search) {
          // 이미 홈이면 다시 불러오지 않고 해시만 지운다
          history.replaceState(history.state, '', next);
        } else {
          location.replace(next);
        }
      };
      redirectLegacyHash();
      addEventListener('hashchange', redirectLegacyHash);
    </script>
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content={THEME_COLOR} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {noindex && <meta name="robots" content="noindex" />}

    {/* 탭 아이콘: 브랜드 결정 전 임시(primary 둥근 사각형 + 흰 "안"). 바꿀 때는 public/의 파일만 교체한다. */}
    <link rel="icon" href={withBase('/favicon.ico')} sizes="16x16 32x32 48x48" />
    <link rel="icon" href={withBase('/favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />

    {/* 공유 미리보기 */}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(ogImage.width)} />
    <meta property="og:image:height" content={String(ogImage.height)} />
    <meta property="og:image:alt" content={ogImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={ogImage.alt} />

    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="preload" as="style" href={PRETENDARD_CSS} onload={"this.onload=null;this.rel='stylesheet'"} />
    <noscript><link rel="stylesheet" href={PRETENDARD_CSS} /></noscript>
  </head>
  <body>
    <a class="skip-link btn btn-primary" href="#main">본문으로 건너뛰기</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
